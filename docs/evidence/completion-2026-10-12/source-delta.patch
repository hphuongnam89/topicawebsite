import Link from "next/link";
import { Container } from "@/components/ui/Container";
import { getPublicAdmissionRounds } from "@/lib/services/cms-models";
import { formatDateTimeGMT7 } from "@/lib/date";

export function CurrentAdmissions() {
  const rounds = getPublicAdmissionRounds()
    .filter((row) => row.status === "open")
    .sort((a, b) => a.deadlineAt.localeCompare(b.deadlineAt));
  return (
    <section
      className="border-b border-line-200 bg-paper py-6"
      aria-label="Thông tin kỳ tuyển sinh"
    >
      <Container>
        {rounds.length ? (
          <div className="grid gap-4 md:grid-cols-2">
            {rounds.map((round) => (
              <div key={round.id} className="text-ink-700">
                <h2 className="text-body-lg font-semibold text-navy-950">{round.name}</h2>
                <p>Hạn hồ sơ: {formatDateTimeGMT7(round.deadlineAt)} (giờ Việt Nam)</p>
                <Link
                  className="mt-2 inline-block font-semibold text-navy-800 underline"
                  href="/tuyen-sinh/"
                >
                  Xem điều kiện và hướng dẫn
                </Link>
              </div>
            ))}
          </div>
        ) : (
          <p className="text-ink-700">
            Bạn đang tìm kỳ tuyển sinh phù hợp?{" "}
            <Link href="/lien-he/" className="font-semibold text-navy-800 underline">
              Nhận tư vấn về lịch và hồ sơ.
            </Link>
          </p>
        )}
      </Container>
    </section>
  );
}

