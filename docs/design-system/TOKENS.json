{
  "color": {
    "$type": "color",
    "brand": {
      "50": { "$value": "#FBF8F2", "$description": "Subtle brand surface" },
      "100": { "$value": "#F2E7D5", "$description": "Selected and hover surface" },
      "300": { "$value": "#D8B67C", "$description": "Decorative rule and data support" },
      "500": { "$value": "#B78844", "$description": "Official Topica brand anchor" },
      "600": { "$value": "#C78423", "$description": "Secondary warm accent" },
      "700": { "$value": "#9A6B2E", "$description": "Accessible primary action background" },
      "800": { "$value": "#714A20", "$description": "Pressed state and dark brand text" }
    },
    "ink": {
      "950": { "$value": "#11100E", "$description": "Primary heading and dark surface" },
      "800": { "$value": "#292620", "$description": "Body text" },
      "600": { "$value": "#625E58", "$description": "Secondary text" },
      "400": { "$value": "#8996A0", "$description": "Metadata on dark surfaces" }
    },
    "line": {
      "200": { "$value": "#DDD8CF", "$description": "Default border" },
      "100": { "$value": "#ECE8E1", "$description": "Subtle separator" }
    },
    "surface": {
      "canvas": { "$value": "#FFFFFF", "$description": "Main page background" },
      "paper": { "$value": "#F7F5F1", "$description": "Alternate section background" },
      "elevated": { "$value": "#FFFDF9", "$description": "Elevated menu and modal surface" },
      "inverse": { "$value": "{color.ink.950}", "$description": "Dark section background" }
    },
    "semantic": {
      "info": { "$value": "#245B82" },
      "success": { "$value": "#26724F" },
      "warning": { "$value": "#A56416" },
      "error": { "$value": "#B23B3B" },
      "focus": { "$value": "{color.semantic.info}" }
    },
    "text": {
      "primary": { "$value": "{color.ink.950}" },
      "body": { "$value": "{color.ink.800}" },
      "secondary": { "$value": "{color.ink.600}" },
      "inverse": { "$value": "{color.surface.canvas}" },
      "brand": { "$value": "{color.brand.800}" },
      "error": { "$value": "{color.semantic.error}" },
      "success": { "$value": "{color.semantic.success}" }
    },
    "action": {
      "primaryDefault": { "$value": "{color.brand.700}" },
      "primaryHover": { "$value": "{color.brand.800}" },
      "primaryText": { "$value": "{color.surface.canvas}" },
      "secondaryDefault": { "$value": "{color.surface.canvas}" },
      "secondaryHover": { "$value": "{color.surface.paper}" },
      "secondaryText": { "$value": "{color.ink.950}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Lora", "Georgia", "serif"] },
      "body": { "$value": ["Be Vietnam Pro", "Arial", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "12": { "$value": "12px" },
      "14": { "$value": "14px" },
      "16": { "$value": "16px" },
      "18": { "$value": "18px" },
      "20": { "$value": "20px" },
      "24": { "$value": "24px" },
      "26": { "$value": "26px" },
      "30": { "$value": "30px" },
      "36": { "$value": "36px" },
      "40": { "$value": "40px" },
      "48": { "$value": "48px" },
      "64": { "$value": "64px" }
    },
    "lineHeight": {
      "$type": "number",
      "caption": { "$value": 1.5 },
      "label": { "$value": 1.43 },
      "body": { "$value": 1.625 },
      "bodyLarge": { "$value": 1.67 },
      "heading": { "$value": 1.22 },
      "display": { "$value": 1.125 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "default": { "$value": "0px" }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" },
    "30": { "$value": "120px" },
    "40": { "$value": "160px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "4px" },
    "md": { "$value": "6px" },
    "lg": { "$value": "8px" },
    "full": { "$value": "999px", "$description": "Avatar and status dot only" }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "default": { "$value": "1px" },
      "strong": { "$value": "2px" }
    }
  },
  "size": {
    "$type": "dimension",
    "controlSm": { "$value": "40px" },
    "control": { "$value": "48px" },
    "controlLg": { "$value": "52px" },
    "touchTarget": { "$value": "44px" },
    "header": { "$value": "88px" },
    "headerCompact": { "$value": "68px" },
    "container": { "$value": "1240px" },
    "measure": { "$value": "760px" }
  },
  "shadow": {
    "$type": "shadow",
    "xs": {
      "$value": {
        "color": "#11100E0F",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "sm": {
      "$value": {
        "color": "#11100E14",
        "offsetX": "0px",
        "offsetY": "6px",
        "blur": "18px",
        "spread": "-6px"
      }
    },
    "md": {
      "$value": {
        "color": "#11100E1F",
        "offsetX": "0px",
        "offsetY": "18px",
        "blur": "48px",
        "spread": "-14px"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "180ms" },
      "slow": { "$value": "280ms" },
      "enter": { "$value": "420ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$value": [0.16, 1, 0.3, 1] }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "xs": { "$value": "320px" },
    "sm": { "$value": "375px" },
    "md": { "$value": "414px" },
    "tablet": { "$value": "768px" },
    "desktop": { "$value": "1024px" },
    "wide": { "$value": "1440px" }
  },
  "zIndex": {
    "$type": "number",
    "base": { "$value": 0 },
    "sticky": { "$value": 20 },
    "dropdown": { "$value": 30 },
    "overlay": { "$value": 40 },
    "modal": { "$value": 50 },
    "toast": { "$value": 60 }
  }
}
