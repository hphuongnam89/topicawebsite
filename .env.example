NEXT_PUBLIC_SITE_URL=http://localhost:3000



# Secret used for signing admin sessions (JWT or cookie). Replace with a strong random string.
ADMIN_SESSION_SECRET=replace-with-a-random-local-secret

# Initial password for the default admin account. This will be hashed and stored on first login.
ADMIN_INITIAL_PASSWORD=replace-with-a-local-only-password

# Lead delivery is implemented in Phase R6. Keep disabled until a real provider is configured.
LEAD_PROVIDER=disabled
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
