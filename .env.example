# Next.js / APP Router Environment variables
# ========================================
# IMPORTANT: Never commit actual credentials to version control.
# Copy this file to .env and fill in the real values.
#
# Database configuration for production environment.
# Replace with your actual PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/topica_cms

# Frontend URLs
NEXT_PUBLIC_SITE_URL=https://topicauni.edu.vn
WORDPRESS_API_URL=https://topicauni.edu.vn/wp-json/wp/v2

# CMS Revalidation (Admin)
CMS_REVALIDATE_SECONDS=300

# Ingress trust settings for deploy/nginx.conf
TRUSTED_INGRESS=

# Topica-specific configuration
# ========================================
TOPICA_DATA_DIR=
LEAD_RETENTION_DAYS=
ANALYTICS_RETENTION_DAYS=
RETENTION_ALERT_WEBHOOK=
RETENTION_AUDIT_LOG=/app/data/retention-audit.jsonl
BACKUP_DIR=/var/backups/topica
BACKUP_RETENTION_DAYS=30

# Admin account settings
# ================================
ADMIN_SESSION_SECRET=<generate-a-secure-random-string-of-at-least-32-chars>
ADMIN_INITIAL_PASSWORD=<change-after-first-login-with-12+Chars-minimum>
