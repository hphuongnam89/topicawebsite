{
  "name": "topica-edu",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.12"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    }
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx,css}\" \"lib/**/*.{ts,tsx}\" \"data/**/*.{ts,tsx,json}\" \"__tests__/**/*.{ts,tsx}\" \"e2e/**/*.{ts,tsx}\" \"scripts/**/*.{ts,tsx,mjs}\" package.json \"*.{ts,json}\"",
    "test:seo": "tsx scripts/seo-check.ts",
    "test:program-data": "tsx scripts/program-data-check.ts",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:links": "tsx scripts/links-check.ts",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:lighthouse": "node scripts/lighthouse-check.mjs",
    "runtime:check": "node scripts/runtime-check.mjs",
    "retention:leads": "node --conditions=react-server --import tsx scripts/lead-retention.ts",
    "retention:analytics": "node --conditions=react-server --import tsx scripts/analytics-retention.ts",
    "worker:lead-delivery": "node --conditions=react-server --import tsx scripts/lead-delivery-worker.ts",
    "retention:scheduler": "node --conditions=react-server --import tsx scripts/retention-scheduler.ts",
    "verify": "npm run runtime:check && npm run format:check && next typegen && npm run typecheck && npm run lint && npm test && npm run test:reliability && npm run test:postgres && npm run test:program-data && npm run build && npm run build:worker",
    "build:worker": "esbuild scripts/lead-delivery-worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/lead-delivery-worker.mjs && esbuild scripts/retention-scheduler.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/retention-scheduler.mjs && esbuild scripts/migrate-db.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/migrate-db.mjs && esbuild scripts/migrate-sqlite-to-postgres.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/sqlite-migration.mjs",
    "test:reliability": "node --conditions=react-server --import tsx scripts/reliability-check.ts",
    "migrate:db": "node --conditions=react-server --import tsx scripts/migrate-db.ts",
    "migrate:sqlite": "node --conditions=react-server --import tsx scripts/migrate-sqlite-to-postgres.ts",
    "test:postgres": "node --conditions=react-server --import tsx scripts/postgres-check.ts"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "esbuild": "^0.28.0",
    "@types/pg": "^8.15.5"
  }
}
